{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "portpurge",
  "version": "0.1.0",
  "identifier": "com.portpurge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "portpurge",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3NkE0MThFQ0ZGN0YwRUIKUldUcjhQZlBqa0ZxaDdBcHBWVlM2NVJEZ2hxN29qZ2R5L293NTdrTnFnVG5KeHdSaGloaWt2UVkK",
      "endpoints": [
        "https://github.com/placeholder-username/portpurge/releases/latest/download/latest-json"
      ]
    }
  }
}
